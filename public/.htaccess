# Портфолио kononov-design.ru — статические файлы (сборка Next.js, output: "export").
# Лежит в корне сайта на хостинге reg.ru (Apache).

Options -Indexes
DirectoryIndex index.html

# ---------- типы файлов, которые Apache может не знать ----------
# без них не запустятся worker карты Тулы (.mjs), распаковщик 3D-модели (.wasm) и сама модель (.glb)
AddType text/javascript .mjs .js
AddType application/wasm .wasm
AddType model/gltf-binary .glb
AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType image/svg+xml .svg

# ---------- переадресации ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http → https (сертификат Let's Encrypt, продлевается в ISPmanager сам).
  # Перед Apache у reg.ru стоит nginx: за ним %{HTTPS} бывает off и для https-запросов,
  # поэтому смотрим ещё и X-Forwarded-Proto — иначе переадресация зациклится.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # холст переехал на главную
  RewriteRule ^v2/?$ / [R=301,L]

  # адрес без слэша на конце → со слэшем (/cases/hr → /cases/hr/), если такая папка есть
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# ---------- кэш ----------
<IfModule mod_headers.c>
  # Скрипты и стили Next.js с хешем в имени не меняются никогда — кэш на год
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Картинки, видео, модели и шрифты меняются редко: сутки из кэша без запроса к серверу,
  # потом ещё месяц сохранённая копия показывается сразу и обновляется в фоне
  <If "%{REQUEST_URI} =~ m#^/(images|videos|models|draco|icons|fonts|maplibre)/#">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=2592000"
  </If>
  # HTML всегда проверяется — чтобы после выкладки сразу открывалась новая версия
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- сжатие текстовых файлов ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/wasm
</IfModule>
